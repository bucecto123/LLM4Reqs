# ============================================
# LLM Service Environment Configuration
# ============================================
# Copy this file to .env and update values as needed

# Groq API Configuration
GROQ_API_KEY=your-groq-api-key-here    # Get your API key from: https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b         # Default model: openai/gpt-oss-120b
# Optional: Override the default Groq model (default is mixtral-8x7b-32768)
# GROQ_MODEL=gpt-4o                    # Example of using a different model

# LLM Service Authentication
LLM_API_KEY=dev-secret-key-12345       # API key for service authentication (must match backend/.env)

# RAG (Retrieval-Augmented Generation) Configuration
RAG_ENABLED="true"                     # Enable/disable RAG functionality
RAG_INDEX_PATH="faiss_store\faiss_index.bin"  # Path to FAISS index file
RAG_META_PATH="faiss_store\faiss_meta.pkl"    # Path to FAISS metadata file
RAG_TOP_K="5"                          # Number of top results to retrieve
RAG_SIM_THRESHOLD="0.35"               # Similarity threshold for retrieval (0.0-1.0)

# ============================================
# IMPORTANT NOTES:
# ============================================
# - Get your Groq API key from: https://console.groq.com/keys
# - LLM_API_KEY must match the LLM_API_KEY in backend/.env
# - RAG_ENABLED: Set to "false" to disable RAG functionality
# - RAG_SIM_THRESHOLD: Lower values = more results, higher values = more relevant results
# - To build FAISS index, run: python build_faiss.py
# ============================================