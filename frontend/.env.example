# ============================================
# Frontend Environment Configuration
# ============================================
# Copy this file to .env and update values as needed

# API Configuration
VITE_API_BASE=http://localhost:8001    # Backend API URL

# Reverb WebSocket Configuration
# Note: VITE_REVERB_APP_KEY must match REVERB_APP_KEY in backend/.env
VITE_REVERB_APP_KEY=local-app-key      # Must match backend REVERB_APP_KEY
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081                  # WebSocket server port (8080 for Docker, 8081 for local)
VITE_REVERB_SCHEME=http                # Use 'https' in production

# ============================================
# IMPORTANT NOTES:
# ============================================
# - All environment variables must start with VITE_ to be accessible in the app
# - VITE_REVERB_APP_KEY must match backend REVERB_APP_KEY for WebSocket authentication
# - VITE_REVERB_PORT: Use 8080 when running with Docker, 8081 for local development
# - For production, change VITE_REVERB_SCHEME to https and update URLs accordingly
# - After changing .env, restart the dev server (npm run dev)
# ============================================
