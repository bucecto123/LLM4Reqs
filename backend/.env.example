# ============================================
# Backend Environment Configuration
# ============================================
# Copy this file to .env and update values as needed

# LLM Service Configuration
LLM_SERVICE_URL=http://localhost:8000  # LLM FastAPI service URL
LLM_API_KEY=dev-secret-key-12345      # API key for LLM service authentication (must match llm/.env)

# Legacy LLM URL (deprecated, use LLM_SERVICE_URL)
LLM_URL=http://127.0.0.1:8000/extract

# CORS and Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application Configuration
APP_NAME=Laravel
APP_ENV=local
APP_KEY=                               # Generate with: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=db                             # Use 'db' for Docker, '127.0.0.1' for local
DB_PORT=5432
DB_DATABASE=llm4reqs
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password       # Change this to a secure password

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# File Storage and Queue Configuration
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache Configuration
CACHE_STORE=file
# CACHE_PREFIX=

# Memcached Configuration
MEMCACHED_HOST=127.0.0.1

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com     # Your Gmail address
MAIL_PASSWORD=your-app-password        # Gmail App Password (not regular password)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# Conflict Resolution Configuration
AUTO_RESOLVE_CONFLICTS=false           # Set to true to enable automatic conflict resolution

# Broadcasting Configuration
BROADCAST_CONNECTION=reverb

# Reverb WebSocket Server Configuration
REVERB_APP_ID=llm4reqs                 # Your application ID
REVERB_APP_KEY=local-app-key           # Must match frontend VITE_REVERB_APP_KEY
REVERB_APP_SECRET=local-app-secret     # Your secret key
REVERB_HOST="localhost"
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http                     # Use 'https' in production

# Vite Configuration (for frontend WebSocket)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_SERVER_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================
# IMPORTANT NOTES:
# ============================================
# - Generate APP_KEY with: php artisan key:generate
# - Use 'db' for DB_HOST in Docker, '127.0.0.1' for local development
# - For Gmail, create an App Password: https://support.google.com/accounts/answer/185833
# - REVERB_APP_KEY must match frontend VITE_REVERB_APP_KEY
# - For production, use strong passwords and change all default keys
# ============================================
