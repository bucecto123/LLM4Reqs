# LLM Service
LLM_API_KEY=dev-secret-key-12345

# Groq (primary LLM provider — required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (optional fallback provider)
GEMINI_API_KEY=

# Web Search (optional — leave blank to use DuckDuckGo fallback)
TAVILY_API_KEY=

# WebSocket / Reverb — must match REVERB_APP_KEY in backend/.env and
# VITE_REVERB_APP_KEY in frontend/.env (or docker-compose build args)
REVERB_APP_KEY=llm4reqs-reverb-key
